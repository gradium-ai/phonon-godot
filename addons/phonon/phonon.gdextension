[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"

[libraries]
macos.debug = "res://addons/phonon/bin/macos/libphonon_godot.dylib"
macos.release = "res://addons/phonon/bin/macos/libphonon_godot.dylib"
linux.debug.x86_64 = "res://addons/phonon/bin/linux/libphonon_godot.x86_64.so"
linux.release.x86_64 = "res://addons/phonon/bin/linux/libphonon_godot.x86_64.so"
windows.debug.x86_64 = "res://addons/phonon/bin/windows/phonon_godot.x86_64.dll"
windows.release.x86_64 = "res://addons/phonon/bin/windows/phonon_godot.x86_64.dll"

[icons]
PhononSpeaker = "res://addons/phonon/icon.svg"
